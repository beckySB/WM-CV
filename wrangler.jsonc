{
  // Cloudflare Workers static site config.
  // "name" must match the Worker name shown in your Cloudflare dashboard.
  "name": "wm-cv",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "willmartinez.win", "custom_domain": true },
    { "pattern": "www.willmartinez.win", "custom_domain": true }
  ]
}
